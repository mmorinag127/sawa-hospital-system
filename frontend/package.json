{
  "name": "hospital-order-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "generate:menu-import-api": "python3 ../scripts/export_menu_import_openapi.py --output src/generated/menu-import-openapi.json && openapi-typescript src/generated/menu-import-openapi.json -o src/generated/menu-import-api.ts --default-non-nullable false",
    "check:menu-import-api": "python3 ../scripts/export_menu_import_openapi.py --output src/generated/menu-import-openapi.json --check && openapi-typescript src/generated/menu-import-openapi.json -o src/generated/menu-import-api.ts --default-non-nullable false --check",
    "generate:output-history-api": "python3 ../scripts/export_output_history_openapi.py --output src/generated/output-history-openapi.json && openapi-typescript src/generated/output-history-openapi.json -o src/generated/output-history-api.ts",
    "generate:facility-version-api": "python3 ../scripts/export_facility_version_openapi.py --output src/generated/facility-version-openapi.json && openapi-typescript src/generated/facility-version-openapi.json -o src/generated/facility-version-api.ts",
    "generate:base-menu-api": "python3 ../scripts/export_base_menu_openapi.py --output src/generated/base-menu-openapi.json && openapi-typescript src/generated/base-menu-openapi.json -o src/generated/base-menu-api.ts",
    "check:base-menu-api": "python3 ../scripts/export_base_menu_openapi.py --check --output src/generated/base-menu-openapi.json && openapi-typescript src/generated/base-menu-openapi.json -o src/generated/base-menu-api.ts --check",
    "generate:menu-rule-api": "python3 ../scripts/export_menu_rule_openapi.py --output src/generated/menu-rule-openapi.json && openapi-typescript src/generated/menu-rule-openapi.json -o src/generated/menu-rule-api.ts",
    "check:menu-rule-api": "python3 ../scripts/export_menu_rule_openapi.py --check --output src/generated/menu-rule-openapi.json && openapi-typescript src/generated/menu-rule-openapi.json -o src/generated/menu-rule-api.ts --check",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p $PORT -H 0.0.0.0",
    "lint": "eslint .",
    "test": "npm run lint && npm run test:config",
    "test:config": "node --test --test-concurrency=1 tests/config/*.test.js tests/config/*.test.mjs tests/*.test.cjs",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "generate:menu-master-api": "python3 ../scripts/export_menu_master_openapi.py --output src/generated/menu-master-openapi.json && openapi-typescript src/generated/menu-master-openapi.json -o src/generated/menu-master-api.ts",
    "check:menu-master-api": "python3 ../scripts/export_menu_master_openapi.py --check --output src/generated/menu-master-openapi.json && openapi-typescript src/generated/menu-master-openapi.json -o src/generated/menu-master-api.ts --check"
  },
  "dependencies": {
    "@sawa/ui": "file:vendor/sawa-ui-0.1.0-cec0ec17de8a261f6f6ddc58793515835d7323708403dba3a9bdf54dfecc294d.tgz",
    "axios": "^1.20.0",
    "next": "16.4.2",
    "postcss": "8.5.26",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "eslint": "^8.56.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.5"
  }
}
