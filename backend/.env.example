TZ=Asia/Tokyo

# Database (use DB_URI or DB_* parts)
DB_URI=postgresql+psycopg2://user:pass@localhost:5432/orders
DB_HOST=localhost
DB_PORT=5432
DB_USER=orders_app
DB_PASSWORD=change-me
DB_NAME=orders
DB_DRIVER=postgresql+psycopg2

# Redis / Celery
REDIS_URI=redis://localhost:6379/0
USE_CELERY=false

# Storage (local path or gs:// bucket for PDFs/outputs)
STORAGE_PATH=/tmp/orders-storage
STORAGE_URI=gs://your-bucket/path

# Auth
AUTH_DISABLED=false
GOOGLE_OAUTH_CLIENT_ID=
ALLOWED_EMAILS=admin@example.com,operator@example.com
ADMIN_EMAILS=admin@example.com
OPERATOR_USER=admin
OPERATOR_PASSWORD=change-me
ADMIN_TOKEN=
