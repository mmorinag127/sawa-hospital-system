{
  "version": 1,
  "post_deploy_commands": [
    {
      "name": "stg-ocr-ui-readonly",
      "command": "python3 scripts/run_local_stg_ocr_ui_check.py",
      "legacy_steps": [
        {
          "workflow": "verify-stg-ocr-ui.yml",
          "job": "verify",
          "step": "Validate existing staging OCR artifact provenance"
        },
        {
          "workflow": "verify-stg-ocr-ui.yml",
          "job": "verify",
          "step": "Verify current web before and after existing read-only UI checks"
        }
      ]
    }
  ],
  "commands": [
    {
      "name": "backend-tests",
      "command": ": \"${DB_URI:?Set an explicitly owned local test DB_URI before running}\" && PYTHONPATH=\"$PWD/backend:$PWD/backend/tests/unit${PYTHONPATH:+:$PYTHONPATH}\" python3 -m pytest backend/tests",
      "legacy_steps": [
        {
          "workflow": "ci.yml",
          "job": "backend",
          "step": "Run backend tests (US1-4)"
        },
        {
          "workflow": "ci.yml",
          "job": "backend",
          "step": "Verify initial saved-source preservation"
        },
        {
          "workflow": "ci.yml",
          "job": "backend",
          "step": "Verify OCR review-resolution root regression"
        },
        {
          "workflow": "ci.yml",
          "job": "backend",
          "step": "Verify portal login and server session"
        },
        {
          "workflow": "ci.yml",
          "job": "backend",
          "step": "Verify staging copy refresh lifecycle and native PostgreSQL isolation"
        },
        {
          "workflow": "verify-staging-data.yml",
          "job": "verify",
          "step": "Run isolated dataset regressions"
        }
      ]
    },
    {
