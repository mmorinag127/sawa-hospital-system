env        = "prod"
project_id = "your-gcp-project-id-prod"
project_number = "123456789012"
region     = "asia-northeast2"
location   = "ASIA-NORTHEAST2"

raw_retention_days     = 60
firestore_location_id  = "asia-northeast2"
secret_ids = [
  "db-password",
]

cloudrun_secret_env_vars = {
  DB_PASSWORD         = "db-password"
}

cloudrun_services = {
  web          = "asia-northeast2-docker.pkg.dev/your-project/backend/frontend:prod-frontend-YYYYMMDD-HHMMSS"
  worker       = "asia-northeast2-docker.pkg.dev/your-project/backend/backend:prod-backend-YYYYMMDD-HHMMSS"
  "ocr-pipeline" = "asia-northeast2-docker.pkg.dev/your-project/backend/ocr-pipeline:prod-ocr-YYYYMMDD-HHMMSS"
}

cloudrun_service_resources = {
  "ocr-pipeline" = {
    cpu    = "2"
    memory = "8Gi"
  }
}

# pubsub_topic_name        = "orders-prod"
# pubsub_subscription_name = "orders-prod-push"

# worker_service_name  = "worker-prod"

auth_disabled = false
operator_user = "admin"
operator_password = "set-admin-password-here"
google_oauth_client_id = "your-login-client-id.apps.googleusercontent.com"
allowed_emails = ["user@example.com"]
admin_emails = ["admin@example.com"]

notification_emails = ["alerts@example.com"]
