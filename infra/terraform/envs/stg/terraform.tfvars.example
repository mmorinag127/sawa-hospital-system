env        = "stg"
project_id = "sawahospitalsystem"
project_number = "167795504375"
region     = "asia-northeast2"
location   = "ASIA-NORTHEAST2"

raw_retention_days     = 60
firestore_location_id  = "asia-northeast2"
firestore_enabled      = false
project_services       = []
secret_ids = [
  "db-password-stg",
]

cloudrun_secret_env_vars = {
  DB_PASSWORD    = "db-password-stg"
  GEMINI_API_KEY = "gemini-api-key"
  GOOGLE_API_KEY = "gemini-api-key"
}

cloudrun_services = {
  web            = "asia-northeast2-docker.pkg.dev/sawahospitalsystem/backend/frontend:stg-frontend-YYYYMMDD-HHMMSS"
  worker         = "asia-northeast2-docker.pkg.dev/sawahospitalsystem/backend/backend:stg-backend-YYYYMMDD-HHMMSS"
  "ocr-pipeline" = "asia-northeast2-docker.pkg.dev/sawahospitalsystem/backend/ocr-pipeline:stg-ocr-YYYYMMDD-HHMMSS"
}

cloudrun_service_resources = {
  worker = {
    cpu    = "1000m"
    memory = "2Gi"
  }
  "ocr-pipeline" = {
    cpu    = "2"
    memory = "8Gi"
  }
}

cloudrun_service_concurrency = {
  worker = 8
}

cloudrun_worker_url_override = ""
cloudrun_ocr_pipeline_url_override = "https://ocr-pipeline-stg-avlnzjjrca-dt.a.run.app"

auth_disabled = false
operator_user = "admin"
operator_password = "set-stg-admin-password-here"
google_oauth_client_id = "your-stg-login-client-id.apps.googleusercontent.com"
allowed_emails = ["user@example.com"]
admin_emails = ["admin@example.com"]

db_instance_name = "orders-stg"
db_name          = "orders"
db_user          = "orders_app"
db_tier          = "db-f1-micro"
db_password_secret_id = "db-password-stg"
db_deletion_protection = false

notification_emails = ["alerts@example.com"]
